# Automatic Solutions Iberia — Apache rewrite rules
# SPA (React Router) support: serve index.html for any unmatched route

Options -MultiViews
RewriteEngine On

# If file or directory does not exist, fall back to index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Security / MIME
AddType image/x-icon .ico
AddType application/manifest+json .webmanifest

# Cache static assets aggressively (they have hashed filenames)
<FilesMatch "\.(js|css|woff2?|ttf|eot|svg|jpg|jpeg|png|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
# Never cache HTML
<FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

# Gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
